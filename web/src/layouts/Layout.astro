---
interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = "overview" } = Astro.props;

const navItems = [
  { href: "/", label: "Overview", key: "overview" },
  { href: "/variants", label: "Variants", key: "variants" },
  { href: "/predictions", label: "Risk Predictions", key: "predictions" },
  { href: "/evaluation", label: "Evaluation", key: "evaluation" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 1000 Genomics Risk Prediction</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen">
    <nav class="border-b border-[var(--border)] bg-[var(--bg-secondary)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">G</div>
            <span class="font-semibold text-lg">GenomeRisk</span>
            <span class="text-xs text-[var(--text-secondary)] bg-[var(--bg-card)] px-2 py-0.5 rounded-full">1000 Genomes</span>
          </div>
          <div class="flex gap-1">
            {navItems.map((item) => (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  activePage === item.key
                    ? "bg-[var(--accent-blue)] text-white"
                    : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-card)]"
                }`}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <footer class="border-t border-[var(--border)] mt-16 py-6 text-center text-sm text-[var(--text-secondary)]">
      1000 Genomes Disease Risk Prediction Pipeline &middot; Vertex AI + BigQuery + Astro
    </footer>
  </body>
</html>
